    <eStructuralFeatures xsi:type="ecore:EReference" name="boundaryEventRefs" ordered="false" upperBound="-1" eType="events.ecore#//BoundaryEvent" eOpposite="events.ecore#//BoundaryEvent/attachedToRef" />
