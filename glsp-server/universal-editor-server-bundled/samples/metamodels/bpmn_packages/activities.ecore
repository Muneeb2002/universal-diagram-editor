<ecore:EPackage xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmi:version="2.0" name="activities" nsURI="http://www.omg.org/spec/BPMN/20100524/MODEL-XMI/activities" nsPrefix="bpmn.activities">
