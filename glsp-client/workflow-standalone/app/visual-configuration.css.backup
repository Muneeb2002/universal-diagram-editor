/* Visual Configuration Styles for Instance Nodes */

/* Base instance node styling - default blue theme */
.ecore-instance {
    stroke-width: 2px !important;
}

/* Shape-specific styling */
.shape-rectangle {
    /* Default rectangle shape - no special styling needed */
}

.shape-circle {
    border-radius: 50%;
}

.shape-ellipse {
    border-radius: 50% 25%;
}

.shape-diamond {
    transform: rotate(45deg);
    border-radius: 0;
}

.shape-hexagon {
    clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);
}

.shape-triangle {
    clip-path: polygon(50% 0%, 100% 100%, 0% 100%);
}

.shape-pentagon {
    clip-path: polygon(50% 0%, 100% 38%, 82% 100%, 18% 100%, 0% 38%);
}

.shape-star {
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
}

/* Arrow shapes */
.shape-arrow-right {
    clip-path: polygon(0% 30%, 60% 30%, 60% 20%, 100% 50%, 60% 80%, 60% 70%, 0% 70%);
}

.shape-arrow-left {
    clip-path: polygon(100% 30%, 40% 30%, 40% 20%, 0% 50%, 40% 80%, 40% 70%, 100% 70%);
}

.shape-arrow-up {
    clip-path: polygon(30% 100%, 30% 40%, 20% 40%, 50% 0%, 80% 40%, 70% 40%, 70% 100%);
}

.shape-arrow-down {
    clip-path: polygon(30% 0%, 30% 60%, 20% 60%, 50% 100%, 80% 60%, 70% 60%, 70% 0%);
}

/* Color rules moved to end of file for higher specificity */

/* Border style variations */
.border-dashed {
    stroke-dasharray: 5, 5;
}

.border-dotted {
    stroke-dasharray: 2, 2;
}

.border-solid {
    stroke-dasharray: none;
}

/* Hover effects for interactive elements */
.ecore-instance:hover {
    stroke-width: calc(var(--border-width, 2px) + 1px);
    filter: brightness(1.1);
}

/* Focus styles for accessibility */
.ecore-instance:focus {
    outline: 2px solid var(--stroke-color, #1976D2);
    outline-offset: 2px;
}

/* Animation for shape transitions */
.ecore-instance {
    transition: all 0.3s ease-in-out;
}

/* Special styling for different compartments */
.ecore-instance .comp\:header {
    font-weight: bold;
    font-size: 14px;
}

.ecore-instance .comp\:attributes {
    font-size: 12px;
    opacity: 0.9;
}

.ecore-instance .comp\:references {
    font-size: 12px;
    opacity: 0.8;
    font-style: italic;
}

/* Responsive sizing */
@media (max-width: 768px) {
    .ecore-instance {
        min-width: 120px;
        min-height: 80px;
    }
}

/* Print styles */
@media print {
    .ecore-instance {
        fill: white !important;
        stroke: black !important;
        color: black !important;
    }
}

/* ===== COLOR SCHEMES - HIGHEST SPECIFICITY ===== */
/* Default blue color scheme - applied when no specific color is set */
.ecore-instance:not([class*="color-"]) {
    fill: #E3F2FD !important;
    stroke: #1976D2 !important;
    color: #0D47A1 !important;
}

/* Blue color scheme */
.color-blue,
.color-blue rect,
.color-blue circle,
.color-blue ellipse,
.color-blue polygon,
.color-blue path {
    fill: #E3F2FD !important;
    stroke: #1976D2 !important;
    color: #0D47A1 !important;
}

/* Green color scheme */
.color-green,
.color-green rect,
.color-green circle,
.color-green ellipse,
.color-green polygon,
.color-green path {
    fill: #E8F5E8 !important;
    stroke: #388E3C !important;
    color: #1B5E20 !important;
}

/* Red color scheme */
